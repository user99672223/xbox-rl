+    if (!XrlLookupDevice(device, &call.device, &call.queue))
+    {
+        /* Not a device d3d11.dll made: the game passed its own ID3D12CommandQueue (D3D12 path).  The
+         * owning device comes from a native call on the queue. */
+        ID3D12CommandQueue *q = (ID3D12CommandQueue *)device;
+        ID3D12Device *d12 = NULL;
+        HRESULT hr = ID3D12CommandQueue_GetDevice(q, &IID_ID3D12Device, (void **)&d12);
+
+        if (FAILED(hr) || !d12) { WARN("cannot get the device of queue %p: %#lx.\n", device, hr); return DXGI_ERROR_UNSUPPORTED; }
+        call.device = (UINT64)(ULONG_PTR)d12;
+        call.queue  = (UINT64)(ULONG_PTR)q;
+        ID3D12Device_Release(d12);   /* the queue keeps it alive; we only needed the pointer value */
+    }
+    nt = XrlCall(XRL_CALL_GFX_CREATE_SWAPCHAIN, &call, &status);
