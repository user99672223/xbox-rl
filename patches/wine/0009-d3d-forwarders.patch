+/* xbox-rl: `device` is a native D3D11-on-12 device (made by our d3d11.dll, so its D3D12 device and
+ * queue are in xrlhost's table) or the game's own native ID3D12CommandQueue.  Wine must not
+ * QueryInterface it for Wine interfaces; the swapchain is created on the host's CoreWindow.
+ * KNOWN GAP: the returned object is the host's raw IDXGISwapChain3.  A D3D11 game's
+ * GetBuffer(IID_ID3D11Texture2D) needs a Wine-side wrapper doing CreateWrappedResource +
+ * Acquire/ReleaseWrappedResources around Present (gfx/ABI-CHANGE-REQUESTS.md R4).  Not written. */
+static HRESULT xrl_create_native_swapchain(IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc,
+        IDXGISwapChain1 **swapchain)
+{
+    struct xrl_call_gfx_swapchain call = { .width = desc->Width, .height = desc->Height,
+        .buffer_count = desc->BufferCount, .dxgi_format = desc->Format };
+    INT status = XRL_STATUS_GENERIC;
+    NTSTATUS nt;
