diff --git a/dlls/xrlhost/main.c b/dlls/xrlhost/main.c
index f36d6bd..5bd1529 100644
--- a/dlls/xrlhost/main.c
+++ b/dlls/xrlhost/main.c
@@ -79,6 +79,28 @@ static CRITICAL_SECTION_DEBUG track_cs_debug =
 };
 static CRITICAL_SECTION track_cs = { &track_cs_debug, -1, 0, 0, 0, 0 };
 
+/* A game may hand dxgi any interface of the device (ID3D11Device, IDXGIDevice, ...): the tracking table
+ * is keyed by the ID3D11Device pointer. */
+static const void *canonical_device( const void *obj )
+{
+    static const GUID iid_d3d11_device = { 0xdb6f6ddb, 0xac77, 0x4e88, { 0x82, 0x53, 0x81, 0x9d, 0xf9, 0xbb, 0xf1, 0x40 } };
+    typedef HRESULT (WINAPI *qi_func)( const void *, const GUID *, void ** );
+    typedef ULONG (WINAPI *release_func)( const void * );
+    void *unk = NULL;
+    const void * const *vtbl;
+
+    if (!obj) return obj;
+    __TRY
+    {
+        vtbl = *(const void * const * const *)obj;
+        if (((qi_func)vtbl[0])( obj, &iid_d3d11_device, &unk ) != S_OK) unk = NULL;
+        else ((release_func)vtbl[2])( unk );
+    }
+    __EXCEPT_PAGE_FAULT { unk = NULL; }
+    __ENDTRY
+    return unk ? unk : obj;
+}
