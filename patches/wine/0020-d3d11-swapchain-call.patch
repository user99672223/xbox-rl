+    if (i == MAX_TRACKED) for (i = 0; i < MAX_TRACKED; i++) if (!tracked[i].dev11) break;
     if (i == MAX_TRACKED) { ERR( "too many tracked devices\n" ); i = MAX_TRACKED - 1; }
     tracked[i].dev11 = dev11; tracked[i].dev12 = dev12; tracked[i].queue = queue;
     LeaveCriticalSection( &track_cs );
@@ -101,6 +126,7 @@ BOOL WINAPI XrlLookupDevice( const void *dev11, UINT64 *dev12, UINT64 *queue )
     BOOL ret = FALSE;
