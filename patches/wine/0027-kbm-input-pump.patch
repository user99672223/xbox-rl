+/* identical layout to xrl_input_event: Linux evdev vocabulary (type EV_KEY 1 .. see xrl_abi.h XRL_IEV_*) */
+struct xrl_ievent { UINT16 type, code; INT32 value; UINT64 time_ns; };
+#define XRL_IEV_KEY   1
+#define XRL_IEV_REL   2
+#define XRL_IEV_ABS   3
+#define XRL_IEV_TEXT  4
+#define XRL_IEV_FOCUS 5
+#define XRL_ABS_MAX   32767
+#define XRL_MOUSE_ABSOLUTE 0
+#define XRL_MOUSE_RELATIVE 1
