index 707bea2..ad76817 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -970,6 +970,31 @@ void *get_builtin_so_handle( void *module )
     return ret;
 }
 
+/* xbox-rl: a native module built against glibc (the EAC runtime's easyanticheat_x64.so) needs the
+ * glibc-only libc symbols (__printf_chk, __isoc23_*, __ctype_b_loc, ...). musl's loader turns a
+ * DT_NEEDED libc.so.6 into itself, so the glibc-ABI shim (wine/glibc-compat, shipped as
+ * /lib/libgcompat.so.0) cannot be a dependency: load it RTLD_GLOBAL once, before the first unix
+ * library that is not Wine's own (those live next to ntdll.so and never need it).
+ * XRL_GLIBC_COMPAT overrides the path, set empty to disable. A missing file is fine. */
+static void xrl_load_glibc_compat( const char *unix_lib_path )
+{
+    static int done;
+    const char *path, *slash;
+    Dl_info info;
+    size_t len;
+
+    if (done) return;
+    if (dladdr( xrl_load_glibc_compat, &info ) && info.dli_fname && (slash = strrchr( info.dli_fname, '/' )))
+    {
+        len = slash - info.dli_fname;
+        if (!strncmp( unix_lib_path, info.dli_fname, len ) && unix_lib_path[len] == '/') return;
+    }
+    done = 1;
+    if (!(path = getenv( "XRL_GLIBC_COMPAT" ))) path = "/lib/libgcompat.so.0";
+    if (!*path || access( path, R_OK )) return;
+    if (!dlopen( path, RTLD_NOW | RTLD_GLOBAL )) ERR( "cannot load the glibc compatibility library %s: %s\n", debugstr_a(path), dlerror() );
+}
+
 static void load_steam_overlay(const char *unix_lib_path)
 {
     const char *preload, *p;
@@ -977,6 +1002,8 @@ static void load_steam_overlay(const char *unix_lib_path)
     unsigned int len;
     void *handle;
 
+    xrl_load_glibc_compat( unix_lib_path );
+
     if (!strstr(unix_lib_path, "winex11.so")) return;
     if (getenv("LD_PRELOAD") || !(preload = getenv("WINE_LD_PRELOAD"))) return;
 
