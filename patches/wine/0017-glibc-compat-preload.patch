+/* xbox-rl: a native module built against glibc (the EAC runtime's easyanticheat_x64.so) needs the
+ * glibc-only libc symbols (__printf_chk, __isoc23_*, __ctype_b_loc, ...). musl's loader turns a
+ * DT_NEEDED libc.so.6 into itself, so the glibc-ABI shim (wine/glibc-compat, shipped as
+ * /lib/libgcompat.so.0) cannot be a dependency: load it RTLD_GLOBAL once, before the first unix
+ * library. XRL_GLIBC_COMPAT overrides the path; set empty to disable. A missing file is fine. */
+static void xrl_load_glibc_compat(void)
+{
+    static int done;
+    const char *path;
+
+    if (done) return;
+    done = 1;
+    if (!(path = getenv( "XRL_GLIBC_COMPAT" ))) path = "/lib/libgcompat.so.0";
+    if (!*path || access( path, R_OK )) return;
+    if (!dlopen( path, RTLD_NOW | RTLD_GLOBAL )) ERR( "cannot load the glibc compatibility library %s: %s\n", debugstr_a(path), dlerror() );
+}
+
 static void load_steam_overlay(const char *unix_lib_path)
 {
+    xrl_load_glibc_compat();
     const char *preload, *p;
     char path[PATH_MAX];
     unsigned int len;
