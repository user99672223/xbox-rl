+/***********************************************************************
+ * xbox-rl: arch_prctl(ARCH_SET_FS, %rsi) through the host syscall gateway.
+ *
+ * Replaces the raw `syscall` instruction in the dispatchers' slow path (taken
+ * when user_shared_data says RDWRFSGSBASE is unavailable).  Calling the C ABI
+ * function xrl_syscall(nr, a1..a6) clobbers more registers than `syscall` did,
+ * so r8/r9/r10 (live syscall arguments) are saved on the stack below the frame,
+ * rsp is parked in %rbx (free on both paths: it is saved in the frame and only
+ * reloaded later) and realigned to 16 bytes for the call.
+ */
+#define XRL_SET_FS_FROM_RSI \
+    "movq %rsp,%rbx\n\t" \
+    "subq $0x30,%rsp\n\t" \
+    "andq $~15,%rsp\n\t" \
+    "movq %r8,0x08(%rsp)\n\t" \
+    "movq %r9,0x10(%rsp)\n\t" \
+    "movq %r10,0x18(%rsp)\n\t" \
+    "movq $0,(%rsp)\n\t"            /* a6 */ \
+    "movq %rsi,%rdx\n\t"            /* a2 = pthread_teb */ \
+    "movl $0x1002,%esi\n\t"         /* a1 = ARCH_SET_FS */ \
+    "movl $158,%edi\n\t"            /* nr = SYS_arch_prctl */ \
+    "xorl %ecx,%ecx\n\t" \
+    "xorl %r8d,%r8d\n\t" \
+    "xorl %r9d,%r9d\n\t" \
+    "call " __ASM_NAME("xrl_syscall") "@PLT\n\t" \
+    "movq 0x08(%rsp),%r8\n\t" \
+    "movq 0x10(%rsp),%r9\n\t" \
+    "movq 0x18(%rsp),%r10\n\t" \
+    "movq %rbx,%rsp\n\t"
+
