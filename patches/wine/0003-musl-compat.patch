diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index c7aeea1..38724e6 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -23,6 +23,13 @@
 
 #include "config.h"
 
+/* xbox-rl: the framebuffer-surface helpers further down are only declared inside the
+ * SONAME_LIBEGL block, yet used unconditionally.  There is no EGL on the console; pretend the
+ * soname exists (it is only dlopen()ed on demand, and that fails cleanly). */
+#ifndef SONAME_LIBEGL
+#define SONAME_LIBEGL "libEGL.so.1"
+#endif
+
 #include <assert.h>
 #include <pthread.h>
 #include <dlfcn.h>
