 #include <unistd.h>
 #include <malloc.h>
 #include <dlfcn.h>
@@ -604,6 +605,34 @@ NTSTATUS exec_wineloader( char **argv, int socketfd, const struct pe_image_info
 }
 
 
+/***********************************************************************
+ *           xrl_exec_wineloader
+ *
+ * xbox-rl: the Windows process the one before it created takes over this OS process.
+ * Same environment as exec_wineloader() gives a forked child (the server socket,
+ * WINELOADERNOEXEC), but exec()ed in place: the layer's execve replaces the guest image
+ * and keeps the wineserver thread (docs/decisions.md, "exec handover").  `ranges` are the
+ * old process's views, released by the layer while the old image is dropped.
+ */
+NTSTATUS xrl_exec_wineloader( char **argv, int socketfd, ULONG_PTR (*ranges)[2], unsigned int nranges )
+{
+    char socket_env[64], session_env[64];
+    extern int xrl_session_block_fn_env( char *buf, size_t size );
+
+    unsetenv( "WINE_LD_PRELOAD" );
+    unsetenv( "WINEPRELOADRESERVE" );
+    snprintf( socket_env, sizeof(socket_env), "WINESERVERSOCKET=%u", socketfd );
+    putenv( strdup( socket_env ) );
+    putenv( strdup( "WINELOADERNOEXEC=1" ) );
+    if (xrl_session_block_fn_env( session_env, sizeof(session_env) )) putenv( strdup( session_env ) );
+    argv[1] = strdup( wineloader );
+    prctl( 0x58524c02 /* PR_XRL_EXEC_KEEP */, (unsigned long)ranges, nranges, 0, 0 );
+    execv( argv[1], argv + 1 );
+    prctl( 0x58524c02, 0, 0, 0, 0 );
+    return STATUS_INVALID_IMAGE_FORMAT;
+}
+
+
 /***********************************************************************
  *           exec_wineserver
  *
@@ -669,6 +698,13 @@ int xrl_start_wineserver(void)
 }
 
 
+int xrl_session_block_fn_env( char *buf, size_t size )
+{
+    if (!xrl_server_session_block) return 0;
+    snprintf( buf, size, "XRL_SESSION_BLOCK_FN=%lx", (unsigned long)(ULONG_PTR)xrl_server_session_block );
+    return 1;
+}
+
 /***********************************************************************
  *           xrl_session_block
  *
@@ -680,6 +716,11 @@ int xrl_start_wineserver(void)
 __attribute__((visibility("default")))
 int xrl_session_block( ULONGLONG offset, const char **data, ULONGLONG *base, ULONGLONG *size )
 {
+    if (!xrl_server_session_block)   /* an exec'd Windows process: the server was started by the one before it */
+    {
+        const char *p = getenv( "XRL_SESSION_BLOCK_FN" );
+        if (p) xrl_server_session_block = (void *)(ULONG_PTR)strtoull( p, NULL, 16 );
+    }
     return xrl_server_session_block ? xrl_server_session_block( offset, data, base, size ) : 0;
 }
 
