+/***********************************************************************
+ *           xrl_exec_handover
+ *
+ * xbox-rl: the child process replaces this one inside the same OS process, like execve.
+ * One OS process holds one Windows process's address space (the PE image bases, the
+ * reserved ranges and ntdll's state are per process), so a launcher's CreateProcess of
+ * "the game" cannot run both side by side.  The child's server-side objects exist
+ * already (new_process / new_thread).  Here the parent ends the way ExitProcess ends it
+ * on the server (its other threads are killed, handles closed), and the layer's execve
+ * starts the same wine loader for the child, handing it the server socket; the wineserver
+ * thread and the old musl stay (xrl_exec_wineloader).  Does not return on success:
+ * CreateProcess in the parent never comes back.  See docs/decisions.md.
+ */
+static BOOL xrl_exec_pending;
+static char **xrl_exec_argv;
+static int xrl_exec_socketfd;
+
+static NTSTATUS xrl_exec_handover( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd, int unixdir,
+                                   char *winedebug, HANDLE thread )
+{
+    if (xrl_exec_pending) return STATUS_NOT_SUPPORTED;
+    if (!(xrl_exec_argv = build_argv( &params->CommandLine, 2 ))) return STATUS_NO_MEMORY;
+    xrl_exec_socketfd = socketfd;
+    if (winedebug) putenv( winedebug );
+    if (unixdir != -1)
+    {
+        fchdir( unixdir );
+        close( unixdir );
+    }
+    ERR( "exec handover: this process hands the OS process to %s\n", debugstr_a( xrl_exec_argv[2] ));
+    xrl_exec_pending = TRUE;
+    /* kernelbase resumes a new process's first thread after NtCreateUserProcess returns, which it never will */
+    NtResumeThread( thread, NULL );
+    NtTerminateProcess( 0, 0 );                  /* the parent ends: the server kills its other threads */
+    NtTerminateProcess( NtCurrentProcess(), 0 ); /* ... and the exec runs instead of exit() (below) */
+    return STATUS_INTERNAL_ERROR;
+}
+
+static void DECLSPEC_NORETURN xrl_exec_now(void)
+{
+    ULONG_PTR (*ranges)[2];
+    unsigned int n;
+
+    if (!(ranges = malloc( 16384 * sizeof(*ranges) ))) exit( 1 );
+    n = xrl_virtual_view_ranges( ranges, 16384 );
+    xrl_exec_wineloader( xrl_exec_argv, xrl_exec_socketfd, ranges, n );
+    ERR( "exec handover failed\n" );
+    exit( 1 );
+}
+
+
 /***********************************************************************
  *           spawn_process
  */
@@ -941,7 +993,8 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
         /* xbox-rl: there is one OS process on the console.  Helper processes Wine would normally
          * launch (wineboot, services, explorer, ...) are completed in-process; anything else
          * cannot run and fails here with a clear log line. */
-        if ((status = xrl_spawn_inproc( &path, &params->ImagePathName, process_handle ))) goto done;
+        if ((status = xrl_spawn_inproc( &path, &params->ImagePathName, process_handle,
+                                        params, socketfd[0], unixdir, winedebug, thread_handle ))) goto done;
     }
     else if ((status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info ))) goto done;
 
@@ -1055,7 +1108,11 @@ NTSTATUS WINAPI NtTerminateProcess( HANDLE handle, LONG exit_code )
     if (self)
     {
         if (!handle) process_exiting = TRUE;
-        else if (process_exiting) exit_process( exit_code );
+        else if (process_exiting)
+        {
+            if (xrl_exec_pending) xrl_exec_now();
+            exit_process( exit_code );
+        }
         else abort_process( exit_code );
     }
     return ret;
