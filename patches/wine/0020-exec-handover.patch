+/* xbox-rl: every view's range, for the exec handover (the layer releases them) */
+unsigned int xrl_virtual_view_ranges( ULONG_PTR (*ranges)[2], unsigned int max )
+{
+    struct file_view *view;
+    unsigned int n = 0;
+
+    WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+    {
+        if (n >= max) break;
+        ranges[n][0] = (ULONG_PTR)view->base;
+        ranges[n][1] = view->size;
+        n++;
+    }
+    return n;
+}
