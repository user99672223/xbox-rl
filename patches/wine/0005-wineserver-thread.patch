+/***********************************************************************
+ *           xrl_start_wineserver
+ *
+ * xbox-rl: load wineserver.so, start the server thread, return the client end of
+ * the connection socket (or -1).  See server/main.c: xrl_wineserver_start().
+ */
+int xrl_start_wineserver(void)
+{
+    int (*start)(const char *);
+    char *path;
+    void *handle;
+    int ret;
+
+    if (build_dir) path = build_path( build_dir, "server/wineserver.so" );
+    else path = build_path( ntdll_dir, "wineserver.so" );
+    handle = dlopen( path, RTLD_NOW | RTLD_LOCAL );
+    if (!handle)
+    {
+        fprintf( stderr, "wine: cannot load %s: %s\n", path, dlerror() );
+        free( path );
+        return -1;
+    }
+    free( path );
+    if (!(start = dlsym( handle, "xrl_wineserver_start" )))
+    {
+        fprintf( stderr, "wine: xrl_wineserver_start not found in wineserver.so\n" );
+        return -1;
+    }
+    path = build_dir ? build_path( build_dir, "nls" ) : build_path( data_dir, "nls" );
+    ret = start( path );
+    free( path );
+    return ret;
+}
+
