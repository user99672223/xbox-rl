+/***********************************************************************
+ *           xrl_thread_info
+ *
+ * xbox-rl: the server gives a thread its host OS id once the thread has
+ * initialised (server/process.c: xrl_rebind_ptid). Read back the ids the server
+ * now has for `handle`; returns FALSE until the thread has initialised.
+ */
+static BOOL xrl_thread_info( HANDLE handle, DWORD *pid, DWORD *tid )
+{
+    BOOL ready = FALSE;
+
+    SERVER_START_REQ( get_thread_info )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        req->access = THREAD_QUERY_LIMITED_INFORMATION;
+        if (!wine_server_call( req ) && reply->teb)
+        {
+            *pid = reply->pid;
+            *tid = reply->tid;
+            ready = TRUE;
+        }
+    }
+    SERVER_END_REQ;
+    return ready;
+}
+
