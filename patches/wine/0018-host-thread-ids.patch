diff --git a/server/process.c b/server/process.c
index c314f85..668fe41 100644
--- a/server/process.c
+++ b/server/process.c
@@ -492,8 +492,64 @@ static void kill_all_processes(void);
 
 #define PTID_OFFSET 8  /* offset for first ptid value */
 
-static unsigned int index_from_ptid(unsigned int id) { return id / 4; }
-static unsigned int ptid_from_index(unsigned int index) { return index * 4; }
+/* xbox-rl (docs/gs-teb.md): the TEB is the host's, and the host's exception dispatcher
+ * runs with the guest view of it, ClientId included; host SRW locks taken there record
+ * the waiter by that thread id, so a Wine id different from the OS thread id loses
+ * wake-ups. Threads and the process therefore take the host OS's ids (the layer reports
+ * them as unix tid/pid) once they are known: xrl_rebind_ptid(). Ids handed out by the
+ * table are temporary and live above PTID_BASE, where host ids never are. */
+#define PTID_BASE 0x40000000
+
+static unsigned int index_from_ptid(unsigned int id) { return (id - PTID_BASE) / 4; }
+static unsigned int ptid_from_index(unsigned int index) { return PTID_BASE + index * 4; }
+
+/* host ids -> objects (open addressing, id 0 = empty, ~0 = deleted) */
+struct xrl_host_id { unsigned int id; void *ptr; };
+static struct xrl_host_id *xrl_host_ids;
+static unsigned int xrl_host_cap, xrl_host_used;
+
+static int xrl_host_slot( unsigned int id, int for_insert )
+{
+    unsigned int i, n, del = ~0u;
+    if (!xrl_host_cap) return -1;
+    for (i = (id / 4) & (xrl_host_cap - 1), n = 0; n < xrl_host_cap; n++, i = (i + 1) & (xrl_host_cap - 1))
+    {
+        if (xrl_host_ids[i].id == id) return i;
+        if (xrl_host_ids[i].id == ~0u && del == ~0u) del = i;
+        if (!xrl_host_ids[i].id) return for_insert ? (del != ~0u ? (int)del : (int)i) : -1;
+    }
+    return for_insert && del != ~0u ? (int)del : -1;
+}
+
+static int xrl_host_put( unsigned int id, void *ptr )
+{
+    int i;
+    if ((xrl_host_used + 1) * 2 > xrl_host_cap)
+    {
+        unsigned int j, old_cap = xrl_host_cap, cap = old_cap ? old_cap * 2 : 256;
+        struct xrl_host_id *old = xrl_host_ids;
+        if (!(xrl_host_ids = calloc( cap, sizeof(*xrl_host_ids) ))) { xrl_host_ids = old; return 0; }
+        xrl_host_cap = cap;
+        xrl_host_used = 0;
+        for (j = 0; j < old_cap; j++)
+            if (old[j].id && old[j].id != ~0u) xrl_host_put( old[j].id, old[j].ptr );
+        free( old );
+    }
+    if ((i = xrl_host_slot( id, 1 )) < 0) return 0;
+    xrl_host_ids[i].id = id;
+    xrl_host_ids[i].ptr = ptr;
+    xrl_host_used++;
+    return 1;
+}
+
+unsigned int xrl_rebind_ptid( unsigned int id, unsigned int host_id, void *ptr )
+{
+    if (!host_id || host_id >= PTID_BASE || (host_id & 3) || id == host_id) return id;
+    if (xrl_host_slot( host_id, 0 ) >= 0) return id;   /* taken (never reused while we hold handles) */
+    if (!xrl_host_put( host_id, ptr )) return id;
+    free_ptid( id );
+    return host_id;
+}
 
 /* allocate a new process or thread id */
 unsigned int alloc_ptid( void *ptr )
@@ -536,7 +592,15 @@ unsigned int alloc_ptid( void *ptr )
 void free_ptid( unsigned int id )
 {
     unsigned int index = index_from_ptid( id );
-    struct ptid_entry *entry = &ptid_entries[index - PTID_OFFSET];
+    struct ptid_entry *entry;
+
+    if (id < PTID_BASE)   /* xbox-rl: a host id */
+    {
+        int i = xrl_host_slot( id, 0 );
+        if (i >= 0) { xrl_host_ids[i].id = ~0u; xrl_host_ids[i].ptr = NULL; }
+        return;
+    }
+    entry = &ptid_entries[index - PTID_OFFSET];
 
     entry->ptr  = NULL;
     entry->next = 0;
@@ -552,6 +616,11 @@ void free_ptid( unsigned int id )
 void *get_ptid_entry( unsigned int id )
 {
     unsigned int index = index_from_ptid( id );
+    if (id < PTID_BASE)   /* xbox-rl: a host id */
+    {
+        int i = xrl_host_slot( id, 0 );
+        return i >= 0 ? xrl_host_ids[i].ptr : NULL;
+    }
     if (index < PTID_OFFSET) return NULL;
     if (index - PTID_OFFSET >= used_ptid_entries) return NULL;
     return ptid_entries[index - PTID_OFFSET].ptr;
