+/***********************************************************************
+ *           xrl_adopt_teb
+ *
+ * xbox-rl (docs/gs-teb.md): on the console GS is the host OS's TEB and cannot be
+ * rebased, so a thread's TEB is the host TEB of its own OS thread. Wine prepares
+ * a TEB in its block as usual (here or in the parent thread); the thread itself
+ * then moves the fields Wine owns into the host TEB: the shared swap set from
+ * xrl_abi.h (the layer keeps the host's values of those) and Wine's private
+ * areas. The block keeps everything Wine places next to a TEB (TEB32, debug info,
+ * signal stack); its Self pointer is redirected to the live TEB for code that
+ * finds the TEB from the signal stack. Without the layer (Linux) arch_prctl
+ * 0x5801 fails and nothing changes.
+ */
+#define XRL_TEB_ROW(off, n) { off, n },
+TEB *xrl_adopt_teb( TEB *teb )
+{
+    static const struct { USHORT off, n; } ranges[] = { XRL_TEB_SWAP_RANGES(XRL_TEB_ROW) };
+    struct ntdll_thread_data *td = (struct ntdll_thread_data *)&teb->GdiTebBatch, *htd;
+    sigset_t sigset;
+    TEB *host = NULL;
+    unsigned int i, j;
+
+    if (syscall( SYS_arch_prctl, 0x5801 /* XRL_GET_HOST_TEB */, &host ) || !host || host == teb) return teb;
+
+    for (i = 0; i < ARRAY_SIZE(ranges); i++)
+        for (j = 0; j < ranges[i].n; j++)
+            ((ULONG64 *)((char *)host + ranges[i].off))[j] = ((ULONG64 *)((char *)teb + ranges[i].off))[j];
+    memcpy( &host->GdiTebBatch, &teb->GdiTebBatch, sizeof(host->GdiTebBatch) );
+    memcpy( host->Win32ClientInfo, teb->Win32ClientInfo, sizeof(host->Win32ClientInfo) );
+
+    /* pointers that pointed into the block's TEB */
+    if (teb->ActivationContextStackPointer == &teb->ActivationContextStack)
+        host->ActivationContextStackPointer = &host->ActivationContextStack;
+    InitializeListHead( &host->ActivationContextStack.FrameListCache );
+    htd = (struct ntdll_thread_data *)&host->GdiTebBatch;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    list_remove( &td->entry );
+    list_add_head( &teb_list, &htd->entry );
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+
+    teb->Tib.Self = &host->Tib;
+    return host;
+}
+
+
+/***********************************************************************
+ *           xrl_retire_teb
+ *
+ * xbox-rl: called by an exiting thread on its own TEB. The host frees an adopted
+ * TEB together with its OS thread, but Wine frees a dead thread's stacks later,
+ * from another thread (exit_thread). Move what virtual_free_teb() needs into the
+ * thread's block, which outlives it, and return the block to be freed.
+ */
+TEB *xrl_retire_teb( TEB *teb )
+{
+    struct ntdll_thread_data *td = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    TEB *block = td->xrl_block;
+    sigset_t sigset;
+
+    if (!block || block == teb) return teb;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    list_remove( &td->entry );
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    memcpy( &block->GdiTebBatch, &teb->GdiTebBatch, sizeof(block->GdiTebBatch) );
+    list_init( &((struct ntdll_thread_data *)&block->GdiTebBatch)->entry );
+    block->DeallocationStack = teb->DeallocationStack;
+    block->WowTebOffset = 0;
+    block->Tib.Self = &block->Tib;
+    return block;
+}
+
