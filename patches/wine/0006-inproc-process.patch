+/* xbox-rl: complete a child process that is emulated in-process instead of exec'd.
+ * The process/startup_info objects were created by new_process; mark startup as done
+ * (so NtCreateUserProcess reports success) and end the process with exit_code. */
+@REQ(xrl_stub_process)
+    obj_handle_t handle;                /* process handle returned by new_process */
+    int          exit_code;             /* exit code the stub reports */
+@END
