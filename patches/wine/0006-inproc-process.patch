 }
+
+
+/* xbox-rl: finish a process that is emulated in-process (XRL_NO_SPAWN). */
+DECL_HANDLER(xrl_stub_process)
+{
+    struct process *process = get_process_from_handle( req->handle, PROCESS_TERMINATE );
+
+    if (!process) return;
+    set_process_startup_state( process, STARTUP_DONE );
+    terminate_process( process, NULL, req->exit_code );
+    release_object( process );
+}
