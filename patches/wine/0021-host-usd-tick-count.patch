diff --git a/dlls/kernel32/sync.c b/dlls/kernel32/sync.c
index 8ebc2bb..4b5d87b 100644
--- a/dlls/kernel32/sync.c
+++ b/dlls/kernel32/sync.c
@@ -84,16 +84,8 @@ static BOOL get_open_object_attributes( OBJECT_ATTRIBUTES *attr, UNICODE_STRING
  */
 ULONGLONG WINAPI DECLSPEC_HOTPATCH GetTickCount64(void)
 {
-    ULONG high, low;
-
-    do
-    {
-        high = user_shared_data->TickCount.High1Time;
-        low = user_shared_data->TickCount.LowPart;
-    }
-    while (high != user_shared_data->TickCount.High2Time);
-    /* note: we ignore TickCountMultiplier */
-    return (ULONGLONG)high << 32 | low;
+    /* xbox-rl: TickCountQuad counts the host's clock ticks, see GetTickCount */
+    return (user_shared_data->TickCountQuad * user_shared_data->TickCountMultiplier) >> 24;
 }
 
 /***********************************************************************
@@ -101,8 +93,8 @@ ULONGLONG WINAPI DECLSPEC_HOTPATCH GetTickCount64(void)
  */
 DWORD WINAPI DECLSPEC_HOTPATCH GetTickCount(void)
 {
-    /* note: we ignore TickCountMultiplier */
-    return user_shared_data->TickCount.LowPart;
+    /* xbox-rl: the host's KUSER_SHARED_DATA counts clock ticks (15.625 ms); Wine's own counts ms */
+    return (ULONG)((user_shared_data->TickCountQuad * user_shared_data->TickCountMultiplier) >> 24);
 }
 
 /***********************************************************************
