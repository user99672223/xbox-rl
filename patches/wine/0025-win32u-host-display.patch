+static BOOL xrl_host_display( DEVMODEW *mode, const DEVMODEW *template )
+{
+    const char *env = getenv( "XRL_DISPLAY" );
+    unsigned int width = 0, height = 0, hz = 60;
+
+    if (!env || sscanf( env, "%ux%u@%u", &width, &height, &hz ) < 2 || !width || !height) return FALSE;
+    *mode = *template;
+    mode->dmFields |= DM_POSITION;
+    mode->dmPelsWidth = width;
+    mode->dmPelsHeight = height;
+    mode->dmDisplayFrequency = hz ? hz : 60;
+    return TRUE;
+}
