 #elif defined __x86_64__
-/* Chromium depends on syscall thunks having the same form as on
- * Windows. For 64-bit systems the only viable form we can emulate is
- * having an int $0x2e fallback. Since actually using an interrupt is
- * expensive, and since for some reason Chromium doesn't actually
- * validate that instruction, we can just put a jmp there instead. */
+/* xbox-rl: this thunk used to contain a `syscall` instruction (taken when
+ * KUSER_SHARED_DATA.SystemCall == 0, or intercepted through Linux syscall user
+ * dispatch) and a `call *(0x7ffe1000)` fallback.  On the console neither is
+ * usable: the real Windows kernel would execute `syscall`, and 0x7ffe1000 is not
+ * mappable (the 64K granule at 0x7ffe0000 belongs to the real KUSER_SHARED_DATA).
+ * The thunk now always calls through the __wine_syscall_dispatcher pointer that
+ * the unix side stores into the image at startup (the same scheme arm64 uses).
+ *
+ * The 0x20-byte layout and the "ret at +0x14, return address = +0x1f" geometry
+ * are kept on purpose: __wine_syscall_dispatcher subtracts 0xb from its return
+ * address (signal_x86_64.c) and must land on a `ret`, and code that inspects
+ * the stub still sees a Windows-shaped 0x20-byte thunk.
+ *
+ *  00: mov %rcx,%r10          ; 4c 8b d1
+ *  03: mov $id,%eax           ; b8 imm32
+ *  08: jmp 19                 ; eb 0f
+ *  0a: int3 x10               ; (the old testb/jne/syscall bytes)
+ *  14: ret                    ; target of the dispatcher's "return address - 0xb"
+ *  15: int3 x4
+ *  19: call *__wine_syscall_dispatcher(%rip)   ; ff 15 rel32
+ *  1f: ret
+ */
 # define __ASM_SYSCALL_FUNC(id,name) \
     __ASM_GLOBAL_FUNC( name, \
                        __ASM_SEH(".seh_endprologue\n\t") \
                        ".byte 0x4c,0x8b,0xd1\n\t" /* 00: movq %rcx,%r10 */ \
                        ".byte 0xb8\n\t"           /* 03: movl $i,%eax */ \
                        ".long (" #id ")\n\t" \
-                       ".byte 0xf6,0x04,0x25,0x08,0x03,0xfe,0x7f,0x01\n\t" /* 08: testb $1,0x7ffe0308 */ \
-                       ".byte 0x75,0x03\n\t"      /* 10: jne 15 */ \
-                       ".byte 0x0f,0x05\n\t"      /* 12: syscall */ \
+                       ".byte 0xeb,0x0f\n\t"      /* 08: jmp 19 */ \
+                       ".fill 10,1,0xcc\n\t"      /* 0a: padding */ \
                        ".byte 0xc3\n\t"           /* 14: ret */ \
-                       ".byte 0xeb,0x01\n\t"      /* 15: jmp 18 */ \
-                       ".byte 0xc3\n\t"           /* 17: ret */ \
-                       ".byte 0xff,0x14,0x25\n\t" /* 18: callq *(0x7ffe1000) */ \
-                       ".long 0x7ffe1000\n\t" \
+                       ".fill 4,1,0xcc\n\t"       /* 15: padding */ \
+                       "call *" __ASM_NAME("__wine_syscall_dispatcher") "(%rip)\n\t" /* 19 */ \
                        ".byte 0xc3" )             /* 1f: ret */
 #elif defined __arm__
 # define __ASM_SYSCALL_FUNC(id,name,args) \
