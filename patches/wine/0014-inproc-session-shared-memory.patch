+/***********************************************************************
+ *           xrl_session_block
+ *
+ * xbox-rl: find the server's own mapping of the session block holding `offset`.  The
+ * server is a thread of this process and the layer has no coherent MAP_SHARED file
+ * mappings, so win32u reads session objects through the server's pointer instead of
+ * mapping its own (stale) copy.  Returns 0 when there is no in-process server.
+ */
+__attribute__((visibility("default")))
+int xrl_session_block( ULONGLONG offset, const char **data, ULONGLONG *base, ULONGLONG *size )
+{
+    return xrl_server_session_block ? xrl_server_session_block( offset, data, base, size ) : 0;
+}
+
+
