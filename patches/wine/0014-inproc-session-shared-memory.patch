+
+/* xbox-rl: session blocks published for in-process clients (see xrl_server_session_block).
+ * Blocks are never unmapped and the mapping grows by 3/2, so a small array is plenty. */
+static struct { const char *data; mem_size_t offset, size; } xrl_blocks[64];
+static unsigned int xrl_nblocks;
+
+static void xrl_publish_block( const struct session_block *block )
+{
+    unsigned int n = xrl_nblocks;
+    if (n >= sizeof(xrl_blocks) / sizeof(xrl_blocks[0])) return;
+    xrl_blocks[n].data   = block->data;
+    xrl_blocks[n].offset = block->offset;
+    xrl_blocks[n].size   = block->block_size;
+    __atomic_store_n( &xrl_nblocks, n + 1, __ATOMIC_RELEASE );
+}
+
+/* Called from client threads: the server thread only ever appends to xrl_blocks. */
+__attribute__((visibility("default")))
+int xrl_server_session_block( mem_size_t offset, const char **data, mem_size_t *base, mem_size_t *size )
+{
+    unsigned int i, n = __atomic_load_n( &xrl_nblocks, __ATOMIC_ACQUIRE );
+
+    for (i = 0; i < n; i++)
+    {
+        if (offset < xrl_blocks[i].offset || offset - xrl_blocks[i].offset >= xrl_blocks[i].size) continue;
+        *data = xrl_blocks[i].data;
+        *base = xrl_blocks[i].offset;
+        *size = xrl_blocks[i].size;
+        return 1;
+    }
+    return 0;
 }
 
 static struct session_block *grow_session_mapping( mem_size_t needed )
@@ -1425,6 +1460,7 @@ static struct session_block *grow_session_mapping( mem_size_t needed )
 
     session_mapping->size = new_size;
     list_add_tail( &session.blocks, &block->entry );
+    xrl_publish_block( block );
 
     return block;
 }
