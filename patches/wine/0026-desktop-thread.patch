+/* xbox-rl: no explorer.exe can run (single process): the desktop is user32's desktop thread */
+static BOOL use_desktop_thread(void)
+{
+    static int no_spawn = -1;
+
+    if (no_spawn == -1)
+    {
+        const char *env = getenv( "XRL_NO_SPAWN" );
+        no_spawn = env && env[0] && strcmp( env, "0" );
+    }
+    return no_spawn && NtCurrentTeb()->Peb->KernelCallbackTable;
+}
