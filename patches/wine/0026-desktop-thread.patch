+/* xbox-rl: the in-process desktop thread (single-process Wine, XRL_NO_SPAWN; see docs/decisions.md).
+ *
+ * In Wine the desktop window and the HWND_MESSAGE parent belong to explorer.exe's desktop thread,
+ * which pumps messages for them.  Other threads send to the desktop window and wait for the answer:
+ * the first user call of every thread does send_message( desktop, WM_NULL ) ("wait for the graphics
+ * driver", load_desktop_driver), a mode change sends WM_DISPLAYCHANGE, ...  Without explorer the
+ * server created the desktop window itself (get_desktop_window with force), detached from any thread,
+ * but its user handle entry kept the creating thread's id, so those messages went to whichever
+ * program thread asked first, and waited until it pumped: a deadlock as soon as that thread waits for
+ * the sender (Rocket League: game thread waits for the render thread, render thread waits on WM_NULL).
+ *
+ * This thread is manage_desktop() without the shell, for the null graphics driver: the display GUID
+ * is all zero (explorer's "null" driver), the video key says GraphicsDriver=null, the desktop window
+ * is created with that GUID (WM_NCCREATE sets __wine_display_device_guid), then the message window,
+ * the desktop is sized to the virtual screen, and the thread runs the message loop for the life of
+ * the process (ExitProcess terminates it like any other thread).  WM_DISPLAYCHANGE is handled by
+ * win32u's desktop window proc (resize to the new virtual screen) on this thread.  Not done: wallpaper,
+ * launchers, systray, shell window, explorer's display-settings restorer (one process: nothing to
+ * restore for another). */
+#define DESKTOP_CLASS_ATOM ((LPCWSTR)MAKEINTATOM(32769))
+
+static LONG desktop_state;  /* 0: not started, 1: starting, 2: running, 3: failed */
+static DWORD desktop_tid;
+static BOOL desktop_wait_timed_out;
+
+static void set_null_graphics_driver( const GUID *guid )
+{
+    WCHAR key[128], value[16];
+    DWORD size = sizeof(value);
+    HKEY hkey;
+
+    swprintf( key, ARRAY_SIZE(key), L"System\\CurrentControlSet\\Control\\Video\\"
+              L"{%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}\\0000",
+              guid->Data1, guid->Data2, guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2],
+              guid->Data4[3], guid->Data4[4], guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+    /* a pre-baked prefix has it already: leave it (and the registry) untouched */
+    if (!RegGetValueW( HKEY_LOCAL_MACHINE, key, L"GraphicsDriver", RRF_RT_REG_SZ, NULL, value, &size ) &&
+        !wcscmp( value, L"null" )) return;
+    if (!RegCreateKeyExW( HKEY_LOCAL_MACHINE, key, 0, NULL, REG_OPTION_VOLATILE, KEY_SET_VALUE, NULL,
+                          &hkey, NULL ))
+    {
+        RegSetValueExW( hkey, L"GraphicsDriver", 0, REG_SZ, (const BYTE *)L"null", sizeof(L"null") );
+        RegCloseKey( hkey );
+    }
+}
+
+static DWORD WINAPI desktop_thread( void *arg )
+{
+    GUID guid = {0};  /* the null driver's display GUID, as explorer sets it */
+    MSG msg;
+    HWND hwnd;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_xrl_desktop" );
+    set_null_graphics_driver( &guid );
+
+    hwnd = CreateWindowExW( 0, DESKTOP_CLASS_ATOM, NULL, WS_POPUP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN,
+                            0, 0, 0, 0, 0, 0, 0, &guid );
+    if (!hwnd || NtUserGetAncestor( hwnd, GA_PARENT ))
+    {
+        ERR( "failed to create the desktop window %p, error %lu\n", hwnd, GetLastError() );
+        InterlockedExchange( &desktop_state, 3 );
+        return 1;
+    }
+    if (!CreateWindowExW( 0, L"Message", NULL, WS_POPUP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN,
+                          0, 0, 100, 100, 0, 0, 0, NULL ))
+        ERR( "failed to create the message window, error %lu\n", GetLastError() );
+    NtUserSetWindowPos( hwnd, 0, GetSystemMetrics( SM_XVIRTUALSCREEN ), GetSystemMetrics( SM_YVIRTUALSCREEN ),
+                        GetSystemMetrics( SM_CXVIRTUALSCREEN ), GetSystemMetrics( SM_CYVIRTUALSCREEN ),
+                        SWP_SHOWWINDOW );
+    TRACE( "desktop window %p, message loop starting\n", hwnd );
+    InterlockedExchange( &desktop_state, 2 );
+
+    while (GetMessageW( &msg, 0, 0, 0 )) DispatchMessageW( &msg );
+    TRACE( "desktop message loop exiting\n" );
+    return 0;
+}
+
+/* Called by win32u's get_desktop_window() when the desktop has no window yet.  Starts the desktop
+ * thread once and waits until its windows exist.  STATUS_SUCCESS: they do; STATUS_PENDING: not yet
+ * and the caller must not wait (the desktop thread itself, before its window exists, e.g. a DLL's
+ * thread attach; a caller holding the loader lock, which the new thread needs to start; a caller
+ * holding win32u's user lock, which it needs to create windows); STATUS_UNSUCCESSFUL: the thread
+ * could not start or create the window (win32u falls back to the server-created desktop). */
+static NTSTATUS WINAPI User32StartDesktop( void *args, ULONG size )
+{
+    const ULONG *may_wait = args;
+    HANDLE thread;
+    DWORD tid, start;
+
+    if (GetCurrentThreadId() == desktop_tid) return STATUS_PENDING;
+    if (!InterlockedCompareExchange( &desktop_state, 1, 0 ))
+    {
+        /* suspended until desktop_tid is set: its own early user calls must see it */
+        if ((thread = CreateThread( NULL, 0, desktop_thread, NULL, CREATE_SUSPENDED, &tid )))
+        {
+            desktop_tid = tid;
+            ResumeThread( thread );
+            CloseHandle( thread );
+        }
+        else
+        {
+            ERR( "failed to start the desktop thread, error %lu\n", GetLastError() );
+            InterlockedExchange( &desktop_state, 3 );
+        }
+    }
+
+    if (desktop_state == 1)
+    {
+        if ((size >= sizeof(*may_wait) && !*may_wait) || desktop_wait_timed_out ||
+            RtlIsCriticalSectionLockedByThread( NtCurrentTeb()->Peb->LoaderLock ))
+        {
+            TRACE( "desktop thread starting, not waiting for it\n" );
+            return STATUS_PENDING;
+        }
+        /* explorer gets as long (WaitForInputIdle in get_desktop_window) */
+        start = GetTickCount();
+        while (desktop_state == 1 && GetTickCount() - start < 10000) Sleep( 1 );
+        if (desktop_state == 1)
+        {
+            ERR( "desktop thread not ready after 10 s, going on without it\n" );
+            desktop_wait_timed_out = TRUE;
+            return STATUS_PENDING;
+        }
+    }
+    return desktop_state == 2 ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
