+/* xbox-rl: an address in .dynamic that is already absolute (>= the load base) is taken as is. Patch 0003
+ * leaves the hash, symbol, string and version-symbol entries absolute after relocation, as glibc's ld.so
+ * does; the layer can make them absolute even earlier, before this object decodes itself (EAC reads a
+ * ptrace-stopped child's libc before its loader has run). Adding the base a second time would point
+ * these tables into nowhere. Offsets in a shared object are always below its load base. */
+static void *dyn_addr(struct dso *p, size_t v)
+{
+#if !DL_FDPIC
+	if (v >= (size_t)p->base) return (void *)v;
+#endif
+	return laddr(p, v);
+}
+
