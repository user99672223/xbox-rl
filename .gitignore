*.pfx

# Game payload (copied from laptop; never committed)
/game/
**/rootfs/

# Logs pulled from the console
/results/*.txt
/results/*.log

# Toolchain / editor
.vs/
*.user
CMakeCache.txt
CMakeFiles/

