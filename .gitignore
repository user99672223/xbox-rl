# Secrets
.env

# Vendored upstream trees (fetched by scripts into vendor/; we keep pins + patches)
/vendor/*/
!/vendor/.gitkeep

# Build outputs
/build/
**/build-*/
**/AppPackages/
**/AppX/
**/Debug/
**/Release/
**/x64/
**/bin/
**/obj/
*.appx
*.msix
*.msixbundle
*.pfx

# Game payload (copied from laptop; never committed)
/game/
**/rootfs/

# Logs pulled from the console
/results/*.txt
/results/*.log

# Toolchain / editor
.vs/
*.user
CMakeCache.txt
CMakeFiles/

# layer test roots built in WSL
/layer/tests/tls/out/
host/gen_xbox/

# Run folders, screenshots and videos (they can show account names): never committed
/results/*/
/results/*.png
/results/*.mp4
/results/*.tmp
!/results/present-*.png
!/results/present-pattern-*.png
!/results/display-*.png
!/results/userland-*.png

# Stray build artifacts and dumps
/*.so
/*.so.*
*.dmp
*.bundle
