# wine/pins.env -- the single source of truth for everything upstream we pin.
# Sourced by wine/scripts/*.sh. Change a pin => bump it here, regenerate patches,
# record the reason in wine/notes-B.md.

# --- Proton-GE ---------------------------------------------------------------
# GE-Proton11-11 (published 2026-10-19). Proton-GE does not carry a wine tree of
# its own: its `wine` submodule points at ValveSoftware/wine, and GE applies
# wine-staging + its own hotfix patches at *Proton build time* (protonprep-
# valve-staging.sh). We pin the Valve wine commit that this GE tag references and
# do NOT apply GE's staging layer (see notes-B.md "What 'Proton-GE wine' means").
GE_PROTON_TAG=GE-Proton11-11
GE_PROTON_TAG_COMMIT=c0c2ee35e6d4d3bff4d39c6246ac46636434feb8   # proton-ge-custom @ tag
WINE_REPO=https://github.com/ValveSoftware/wine
WINE_COMMIT=c53678ab22a85f0fad3588dd34f0452a463bd015            # `wine` submodule of the tag; Wine 11.0 base
WINE_VERSION=11.0

# --- musl --------------------------------------------------------------------
MUSL_REPO=https://git.musl-libc.org/git/musl
MUSL_TAG=v1.2.6
MUSL_COMMIT=9fa28ece75d8a2191de7c5bb53bed224c5947417

# --- Host build toolchain expectations (WSL Ubuntu, no cross-musl download) ---
# We build musl ourselves (patched) with the distro gcc, so no prebuilt musl
# cross toolchain is required. PE side uses distro mingw-w64.
PE_CC=x86_64-w64-mingw32-gcc
